    bool _e88 = taskPayload.visible;
    mesh_output.primitives.inner[0].cull = !(_e88);
    mesh_output.primitives.inner[0].colorMask = metal::float4(1.0, 0.0, 1.0, 1.0);
    metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);
    uint localInvocationIndex = __local_invocation_id.x + 1 * (__local_invocation_id.y + 1 * __local_invocation_id.z);
    for(uint vertexIndex = localInvocationIndex; vertexIndex < mesh_output.vertex_count; vertexIndex += 1) {
