// language: metal3.0
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;

struct TaskPayload {
    uint dummy;
};
struct VertexOutput {
    metal::float4 position;
};
struct PrimitiveOutput {
    metal::uint2 indices;
};
struct type_4 {
    VertexOutput inner[2];
};
struct type_5 {
    PrimitiveOutput inner[1];
};
struct MeshOutput {
    type_4 vertices;
    type_5 primitives;
    uint vertex_count;
    uint primitive_count;
};

[[object]] void ts_main(
  metal::uint3 __local_invocation_id [[thread_position_in_threadgroup]]
, object_data TaskPayload& taskPayload [[payload]]
, metal::mesh_grid_properties nagaMeshGrid
) {
    if (metal::all(__local_invocation_id == metal::uint3(0u))) {
        nagaMeshGrid.set_threadgroups_per_grid(metal::uint3(1u, 1u, 1u));
    }
    return;
}


struct ms_mainVertexOutput {
    metal::float4 position [[position]];
};
struct ms_mainPrimitiveOutput {
};
[[mesh]] void ms_main(
  metal::uint3 __local_invocation_id [[thread_position_in_threadgroup]]
, object_data TaskPayload const& taskPayload [[payload]]
, threadgroup MeshOutput& mesh_output
, metal::mesh<ms_mainVertexOutput, ms_mainPrimitiveOutput, 2, 1, metal::topology::line> meshOutput
) {
    if (metal::all(__local_invocation_id == metal::uint3(0u))) {
        mesh_output = {};
    }
    metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);
    metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);
    uint localInvocationIndex = __local_invocation_id.x + 1 * (__local_invocation_id.y + 1 * __local_invocation_id.z);
    for(uint vertexIndex = localInvocationIndex; vertexIndex < mesh_output.vertex_count; vertexIndex += 1) {
        ms_mainVertexOutput vertex_;
        vertex_.position = mesh_output.vertices[vertexIndex].position;
        meshOutput.set_vertex(vertexIndex, vertex_);
    }
    for(uint primitiveIndex = localInvocationIndex; primitiveIndex < mesh_output.primitive_count; primitiveIndex += 1) {
        ms_mainPrimitiveOutput primitive;
        meshOutput.set_index(primitiveIndex * 2 + 0, mesh_output.primitives[primitiveIndex].indices.x);
        meshOutput.set_index(primitiveIndex * 2 + 1, mesh_output.primitives[primitiveIndex].indices.y);
        meshOutput.set_primitive(primitiveIndex, primitive);
    }
    if (metal::all(__local_invocation_id == metal::uint3(0u))) {
        meshOutput.set_primitive_count(mesh_output.primitive_count);
    }
    return;
}
