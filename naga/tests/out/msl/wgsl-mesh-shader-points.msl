// language: metal3.0
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;

struct TaskPayload {
    uint dummy;
};
struct VertexOutput {
    metal::float4 position;
};
struct PrimitiveOutput {
    uint indices;
};
struct type_3 {
    VertexOutput inner[1];
};
struct type_4 {
    PrimitiveOutput inner[1];
};
struct MeshOutput {
    type_3 vertices;
    type_4 primitives;
    uint vertex_count;
    uint primitive_count;
    char _pad4[4];
};

[[object]] void ts_main(
  metal::uint3 __local_invocation_id [[thread_position_in_threadgroup]]
, object_data TaskPayload& taskPayload [[payload]]
, metal::mesh_grid_properties nagaMeshGrid
) {
    if (metal::all(__local_invocation_id == metal::uint3(0u))) {
        nagaMeshGrid.set_threadgroups_per_grid(metal::uint3(1u, 1u, 1u));
    }
    return;
}


struct ms_mainVertexOutput {
    metal::float4 position [[position]];
};
struct ms_mainPrimitiveOutput {
};
[[mesh]] void ms_main(
  metal::uint3 __local_invocation_id [[thread_position_in_threadgroup]]
, object_data TaskPayload const& taskPayload [[payload]]
, threadgroup MeshOutput& mesh_output
, metal::mesh<ms_mainVertexOutput, ms_mainPrimitiveOutput, 1, 1, metal::topology::point> nagaMeshOutput
) {
    if (metal::all(__local_invocation_id == metal::uint3(0u))) {
        mesh_output = {};
    }
    metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);
    return;
}
